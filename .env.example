# ============================================================================
# subasta — environment variables
# ============================================================================
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# `supabase start` (Supabase CLI) prints these for local dev.
# ============================================================================

# ---- Supabase (client + server) -------------------------------------------
# Public — safe for client bundle. Used everywhere.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=

# ---- Supabase service role (server-only — NEVER ship to client) -----------
# Only needed for: local seed scripts, edge function tests, admin tasks.
# In production, use Cloudflare Pages secrets — never .env files in the bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ------------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_APP_NAME=subasta
